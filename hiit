<head>

    <meta charset="UTF-8">

    <meta name="viewport"
    content="width=device-width, initial-scale=1.0">

    <!-- SEO -->
    <meta name="description"
    content="Treino HIIT completo com exercícios intensos, queima de gordura e vídeos demonstrativos.">

    <meta name="keywords"
    content="HIIT, cardio, emagrecimento, treino intenso, academia, fitness">

    <meta name="author"
    content="Matheus">

    <title>Treino HIIT | EliteForge</title>

    <link rel="stylesheet"
    href="css/style.css">

</head>

<body class="page-exercicios">

    <!-- HEADER -->
    <header>

        <div class="logo">
            ELITEFORGE
        </div>

        <nav>

            <ul>

                <li>
                    <a href="index.html">
                        Início
                    </a>
                </li>

                <li>
                    <a href="exercicios.html">
                        Exercícios
                    </a>
                </li>

                <li>
                    <a href="index.html#sobre">
                        Sobre
                    </a>
                </li>

                <li>
                    <a href="index.html#contato">
                        Contato
                    </a>
                </li>

            </ul>

        </nav>

    </header>

    <!-- HERO -->
    <section class="musculo-hero">

        <div class="musculo-overlay"></div>

        <div class="musculo-content">

            <span class="musculo-tag">
                HIIT • CARDIO • QUEIMA DE GORDURA
            </span>

            <h1>
                Treino HIIT
            </h1>

            <p>
                Exercícios de alta intensidade
                para melhorar condicionamento,
                resistência e acelerar a queima calórica.
            </p>

        </div>

    </section>

    <!-- EXERCÍCIOS -->
    <section class="exercicios-lista">

        <!-- BURPEE -->
        <div class="exercise-card">

            <div class="exercise-info">

                <h2>
                    Burpee
                </h2>

                <p>
                    Exercício completo que trabalha
                    cardio, pernas, peito e resistência.
                </p>

                <ul>

                    <li>
                        4 séries de 15 repetições
                    </li>

                    <li>
                        Faça em ritmo intenso
                    </li>

                    <li>
                        Controle a respiração
                    </li>

                </ul>

            </div>

            <div class="exercise-video">

                <iframe
                src="https://www.youtube.com/embed/TU8QYVW0gDU"
                title="Burpee"
                loading="lazy"
                allowfullscreen>
                </iframe>

            </div>

        </div>

        <!-- POLICHINELO -->
        <div class="exercise-card">

            <div class="exercise-info">

                <h2>
                    Polichinelo
                </h2>

                <p>
                    Excelente exercício cardiovascular
                    para aquecimento e resistência.
                </p>

                <ul>

                    <li>
                        3 séries de 45 segundos
                    </li>

                    <li>
                        Mantenha ritmo constante
                    </li>

                    <li>
                        Coordene braços e pernas
                    </li>

                </ul>

            </div>

            <div class="exercise-video">

                <iframe
                src="https://www.youtube.com/embed/c4DAnQ6DtF8"
                title="Polichinelo"
                loading="lazy"
                allowfullscreen>
                </iframe>

            </div>

        </div>

        <!-- MOUNTAIN CLIMBER -->
        <div class="exercise-card">

            <div class="exercise-info">

                <h2>
                    Mountain Climber
                </h2>

                <p>
                    Exercício intenso para abdômen,
                    cardio e resistência física.
                </p>

                <ul>

                    <li>
                        4 séries de 40 segundos
                    </li>

                    <li>
                        Mantenha o abdômen firme
                    </li>

                    <li>
                        Movimento rápido e controlado
                    </li>

                </ul>

            </div>

            <div class="exercise-video">

                <iframe
                src="https://www.youtube.com/embed/nmwgirgXLYM"
                title="Mountain Climber"
                loading="lazy"
                allowfullscreen>
                </iframe>

            </div>

        </div>

        <!-- CORRIDA PARADA -->
        <div class="exercise-card">

            <div class="exercise-info">

                <h2>
                    Corrida Parada
                </h2>

                <p>
                    Exercício simples e eficiente
                    para aumentar frequência cardíaca
                    e resistência.
                </p>

                <ul>

                    <li>
                        5 séries de 30 segundos
                    </li>

                    <li>
                        Levante bem os joelhos
                    </li>

                    <li>
                        Ritmo acelerado
                    </li>

                </ul>

            </div>

            <div class="exercise-video">

                <iframe
                src="https://www.youtube.com/embed/OAJ_J3EZkdY"
                title="Corrida Parada"
                loading="lazy"
                allowfullscreen>
                </iframe>

            </div>

        </div>

    </section>

    <!-- FOOTER -->
    <footer>

        <p>
